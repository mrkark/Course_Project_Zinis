# Server Configuration
PORT=3000
NODE_ENV=development

# MSSQL Database Configuration
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=MalwareSandbox
DB_USER=mrkark
DB_PASSWORD=mrkark9000
DB_TRUST_SERVER_CERTIFICATE=true

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=.exe,.dll,.pdf,.js,.txt,.docx,.zip,.apk
ALLOWED_MIME_TYPES=application/octet-stream,application/pdf,application/javascript,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/zip,application/vnd.android.package-archive

# Frontend URL (для CORS; фронтенд теперь раздаётся тем же сервером)
FRONTEND_URL=http://localhost:3000

# Socket.IO Configuration
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# Analysis Configuration
ENTROPY_THRESHOLD=7.0
RISK_SCORE_CRITICAL=80
RISK_SCORE_HIGH=50
RISK_SCORE_MEDIUM=30

# Auth Configuration
JWT_SECRET=dev-only-change-me-please-a1b2c3d4e5f6
JWT_EXPIRES_IN=7d
JWT_COOKIE_MAX_AGE_MS=604800000
BCRYPT_ROUNDS=10
# Задайте временное значение, чтобы один раз создать администратора через
# POST /api/auth/bootstrap-admin, затем очистите переменную.
BOOTSTRAP_ADMIN_KEY=bootstrap-me-once